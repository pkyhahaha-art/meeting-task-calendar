{
  "name": "meeting-task-calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node --import tsx --test src/lib/validation.test.ts src/lib/eventForm.test.ts src/lib/taskForm.test.ts src/lib/authRouting.test.ts src/lib/notificationRetry.test.ts src/lib/recurrence.test.ts src/lib/taskEmailLink.test.ts",
    "test:watch": "node --import tsx --test --watch src/lib/validation.test.ts src/lib/eventForm.test.ts src/lib/taskForm.test.ts src/lib/authRouting.test.ts src/lib/notificationRetry.test.ts src/lib/recurrence.test.ts src/lib/taskEmailLink.test.ts",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --pretty false"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.19",
    "@fullcalendar/daygrid": "6.1.19",
    "@fullcalendar/interaction": "6.1.19",
    "@fullcalendar/react": "6.1.19",
    "@hookform/resolvers": "5.2.2",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-query": "5.87.4",
    "date-fns": "4.1.0",
    "lucide-react": "0.544.0",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.62.0",
    "react-router-dom": "7.18.4",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.7.3",
    "typescript-eslint": "8.43.0",
    "vite": "6.4.3"
  }
